// This file is managed by ansible, do not modify manually.

prometheus.exporter.unix "local_system" {
  netdev {
    device_exclude = "^(veth|fw|tap).*"
  }
  netclass {
    ignored_devices = "^(veth|fw|tap).*"
  }
}

prometheus.scrape "scrape_metrics" {
  targets = prometheus.exporter.unix.local_system.targets
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

otelcol.receiver.otlp "pve_otel" {
  http {
    endpoint = "127.0.0.1:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.pve_to_prom.input]
  }
}

otelcol.exporter.prometheus "pve_to_prom" {
  resource_to_telemetry_conversion = true
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

prometheus.relabel "filter_metrics" {
  forward_to = [prometheus.remote_write.prom.receiver]
}

prometheus.remote_write "prom" {
  endpoint {
    url = "{{ prom_server }}"
  }
}

loki.source.journal "read"  {
  forward_to    = [loki.write.endpoint.receiver]
  labels        = {component = "{{ loki_label }}"}
}

loki.write "endpoint" {
  endpoint {
    url = "{{ loki_server }}"
  }
}
